{
  "name": "@renovatebot/ruby-semver",
  "version": "0.0.0-semantic-release",
  "description": "Ruby SemVer in TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/renovatebot/ruby-semver.git"
  },
  "files": [
    "/dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "vitest": "vitest run",
    "vitest-debug": "vitest --inspect-brk --no-file-parallelism",
    "lint": "run-s oxfmt oxlint markdown-lint",
    "lint-fix": "run-s oxfmt-fix oxlint-fix markdown-lint-fix",
    "markdown-lint": "markdownlint-cli2",
    "markdown-lint-fix": "markdownlint-cli2-fix",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "prepack": "run-s build",
    "prepare": "run-s \"prepare:*\"",
    "prepare:husky": "husky",
    "test": "run-s lint type-check vitest",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@containerbase/oxlint-plugin": "1.0.3",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.28.8"
}
